rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function profile()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin()  { return hasProfile() && profile().role == 'admin'; }
    function isStaff()  { return hasProfile() && profile().role in ['admin', 'staff']; }

    // ---- users/{uid}: { u, n, role, code, cnt } ----
    match /users/{uid} {
      // own profile (needed at login) or admin sees everyone
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // first-ever signup becomes admin (only while meta/init does not exist)
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && !exists(/databases/$(database)/documents/meta/init)
            && request.resource.data.role == 'admin');

      allow delete: if isAdmin();

      // admin edits anything; staff may only bump their own bill counter
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billCount']));
    }

    // ---- meta/init: written once at first-admin setup ----
    match /meta/{doc} {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/init);
      allow update, delete: if isAdmin();
    }

    // ---- menu/main and settings/main: public read, admin writes ----
    match /menu/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- stock/{menuItemId}: { qty, low } ----
    match /stock/{id} {
      allow read: if true; // allow customers to see what's out of stock
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty']));
    }

    // ---- orders/{id}: { by, day, t, tot, pay, lines, lb } ----
    match /orders/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
      allow create: if isStaff() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- kiosk_orders/{id}: public create, staff read/update/delete ----
    match /kiosk_orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['t','day','cust','phone','tbl','type','lines','sub','d','g','ro','tot','gst','status','token'])
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 50
        && request.resource.data.tot is number
        && request.resource.data.cust is string
        && request.resource.data.cust.size() <= 60;
      allow read, update, delete: if isStaff();
    }

    // ---- kiosk_counter/{day}: daily token counter, public can only add 1 ----
    match /kiosk_counter/{day} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
  }
}
